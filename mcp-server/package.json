{
  "name": "mcp-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:ui && node scripts/dev-start.mjs",
    "build": "node scripts/prepare-presentation-assets.mjs && npm run build:ui && tsc -p tsconfig.build.json && node scripts/copy-ui-dist.mjs",
    "build:ui": "tsc -p tsconfig.ui.json --noEmit && node scripts/build-ui.mjs",
    "verify:ui-runtime-artifacts": "node scripts/build-ui.mjs --check && node scripts/verify-ui-runtime-artifacts.mjs --dist",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "start": "node dist/server.js",
    "smoke:runtime": "node scripts/runtime-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "cld3-asm": "^4.0.0",
    "openai": "^6.17.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "esbuild": "^0.24.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
